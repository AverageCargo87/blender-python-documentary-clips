# Only needed for narration and sound effects (lib/narration.mjs, clips/03-fire/scripts/zvuki.mjs).
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Any ElevenLabs voice id that speaks Russian.
ELEVENLABS_VOICE_ID=your-voice-id
# Optional: path to Blender 5.2 for run.sh (defaults to `blender` on PATH).
BLENDER=/path/to/blender
# Optional: download link of the Smithsonian woolly mammoth full-resolution OBJ zip (clip 02 dwelling).
SI_MAMMOTH_URL=
